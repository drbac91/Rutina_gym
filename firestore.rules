// Reglas de seguridad de Firestore (se pegan en la consola de Firebase:
// Firestore Database → Reglas → Publicar). Este archivo es solo de referencia.
//
// - Cada persona lee y escribe ÚNICAMENTE dentro de users/{su propio uid}.
// - Solo pueden entrar las dos cuentas de Google autorizadas.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
             'bryancerda91@gmail.com',
             'jesy.frick@gmail.com'
           ];
    }
  }
}
